# AgriSmart AI — Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ================================================================
# BACKEND CONFIGURATION
# ================================================================

# Flask server port (default: 5000)
PORT=5000

# Set to True to enable Flask debug mode (dev only, never in prod)
FLASK_DEBUG=False

# ================================================================
# OPTIONAL: Weather API Integration (Phase 6)
# ================================================================
# Sign up at https://openweathermap.org/api to get a free API key
# OPENWEATHER_API_KEY=your_openweather_api_key_here


# ================================================================
# OPTIONAL: AI Assistant / RAG (Phase 7)
# ================================================================
# Google Gemini / OpenAI API key for agricultural Q&A assistant
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
